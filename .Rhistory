# Simulate WT-Population without any mutations
simulate_one_gen <- function(N_a0, N_j0, R_a, S_j, S_a){
N_jt <- R_a * N_a0
N_at <- S_j * N_j0 + S_a * N_a0
return(c(N_jt, N_at))
}
print(simulate_one_gen(100, 100, 2, 0.3, 0.6))
print(simulate_one_gen(200, 90, 2, 0.3, 0.6))
print(simulate_one_gen(400, 147, 2, 0.3, 0.6))
# Simulate WT-Population without any mutations and stochasticity
simulate_one_gen <- function(N_a0, N_j0, R_a, S_j, S_a){
N_jt <- rpois(1, R_a * N_a0)
N_at <- rpois(1, S_j * N_j0 + S_a * N_a0)
return(c(N_jt, N_at))
}
print(simulate_one_gen(400, 147, 2, 0.3, 0.6))
print(simulate_one_gen(100, 100, 2, 0.3, 0.6))
print(simulate_one_gen(100, 100, 2, 0.3, 0.6))
print(simulate_one_gen(100, 100, 2, 0.3, 0.6))
