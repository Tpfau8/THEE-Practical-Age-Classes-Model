# Simulate WT-Population without any mutations and stochasticity
simulate_one_gen <- function(N_j0, N_a0,N_j0M, N_a0M, R_a, S_j, S_a){
N_jt <- rpois(1, R_a * N_a0) #calculating number of juvenile individuals. Initial adult population multiplied with Reproduction rate
N_at <- rpois(1, S_j * N_j0 + S_a * N_a0) #calculating number of adult individuals
return(c(N_jt, N_at))
}
print(simulate_one_gen(100, 100, 2, 0.1, 0.6))
