lambda_0
# 2. Function to compute required reproduction multiplier (r) for a given survival multiplier (s)
find_repro_multiplier <- function(advantage, matrix, target_lambda) {
F1 <- matrix[1, 1]
F2 <- matrix[1, 2]
P1 <- matrix[2, 1]
P2 <- matrix[2, 2]
num <- target_lambda^2 - advantage * P2 * target_lambda
den <- F1 * target_lambda - advantage * (F1 * P2 - F2 * P1)
return(num / den)
}
# 2. Function to compute required reproduction multiplier (r) for a given survival multiplier (s)
find_repro_multiplier <- function(survival_advantage, matrix, target_lambda) {
F1 <- matrix[1, 1]
F2 <- matrix[1, 2]
P1 <- matrix[2, 1]
P2 <- matrix[2, 2]
num <- target_lambda^2 - survival_advantage * P2 * target_lambda
den <- F1 * target_lambda - survival_advantage * (F1 * P2 - F2 * P1)
return(num / den)
}
# Resident growth rate (dominant eigenvalue) by gemini (delete later )
lambda_0 <- max(Re(eigen(l_matrix_Mut)$values))
lambda_0
